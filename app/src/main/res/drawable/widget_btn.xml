<?xml version="1.0" encoding="utf-8"?>
<!-- High-contrast pressed state for the widget's refresh button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#66FFFFFF" /><stroke android:width="1.5dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#1FFFFFFF" /></shape>
    </item>
</selector>
